# Optional. Everything has a safe default; Mock needs no tenant and no credentials.
# PORT must be 7827 (this app's one allocated port).
PORT=7827
# PGS_BIND=127.0.0.1   # loopback only unless you set this on purpose (Docker sets PGS_BIND=0.0.0.0)
# Start mode. Empty (the default) = Real when the Real switch is enabled, else Mock. Docker: compose passes PGS_MODE as MODE.
# MODE=
# This lab has NO live mode: it contacts no Privilege Hubs gateway and no Google API in any mode.
# PGS_MODE_REAL=1     # enable the rule-19 Real switch (the page keeps its simulation banner)
